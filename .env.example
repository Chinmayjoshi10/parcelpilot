# ---------------------------------------------------------------------------
# ParcelPilot environment. Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# Postgres 18 running locally (service postgresql-x64-18, data dir E:\New folder\data).
# The app connects as a NON-superuser role on purpose: row-level security is
# bypassed by superusers and by table owners, so enforcing tenancy requires
# that the runtime role be neither.
DATABASE_URL=postgresql://parcelpilot_app:CHANGEME@127.0.0.1:5432/parcelpilot

# Used only by `parcelpilot db bootstrap` to CREATE DATABASE / CREATE ROLE.
# Not read at request time.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGEME@127.0.0.1:5432/postgres

# --- LLM provider -----------------------------------------------------------
# Provider is pluggable; see agentcore/llm/. Implemented: gemini, null.
# ("openai" is a declared seam with no adapter written yet -- it fails at
# startup with a clear message rather than an opaque ImportError.)
# Absent key => engine refuses to synthesise rather than guessing.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Cheap model for tool routing (called many times per run).
LLM_ROUTING_MODEL=gemini-2.5-flash
# The call that must produce a cited answer.
#
# flash by MEASUREMENT, not assumption. On gemini-2.5-pro synthesis was 81% of
# wall clock (19.6s of 24.1s) because the thinking budget dominates. On flash the
# full golden set still passes 22/22 -- including every citation and refusal case
# -- and answers land in 1-10s instead of 11-26s. A 2.5x speedup with no measured
# quality loss.
#
# Switch to gemini-2.5-pro if you add cases that need deeper reasoning; the eval
# suite is the arbiter, and `parcelpilot eval run` will tell you.
LLM_SYNTHESIS_MODEL=gemini-2.5-flash

# --- Embeddings -------------------------------------------------------------
# api  -> provider embedding endpoint (no torch, fast cold start)
# local-> sentence-transformers (requires the local-embeddings extra)
# none -> lexical-only retrieval. Degraded but functional; logged loudly.
#
# Run `parcelpilot llm probe` after setting the key: it lists the models the
# key can actually reach and measures the real embedding dimension, so these
# values are verified rather than assumed.
EMBEDDING_BACKEND=api
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# --- Vertex AI (only when LLM_PROVIDER=vertex) -------------------------------
# Vertex is the enterprise surface: regional data residency, VPC-SC, CMEK, IAM
# instead of a bearer secret, and audit logs in Cloud Logging.
#
# Project id is part of the URL path, so there is no default that could
# accidentally work. Region affects both data residency and model availability.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
#
# Credentials -- set exactly ONE. Checked in this order:
#   1. VERTEX_ACCESS_TOKEN            zero setup, short-lived. Best first test:
#                                     gcloud auth print-access-token
#   2. GOOGLE_APPLICATION_CREDENTIALS service-account JSON path. Production:
#                                     IAM-governed, self-refreshing.
#                                     Needs: pip install -e ".[vertex]"
#   3. LLM_API_KEY                    Vertex express mode. No gcloud required.
VERTEX_ACCESS_TOKEN=
# For a managed host with no filesystem for secrets, paste the whole
# service-account JSON here instead of a path. An explicit path wins if both
# are set.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
#
# On Vertex the embedding model differs from the Gemini API's catalogue --
# text-embedding-005 and gemini-embedding-001 are the usual choices. Run
# `parcelpilot llm probe` to confirm the model and dimension before ingesting.

# --- Auth -------------------------------------------------------------------
# Demo-grade signing key. Rotate and move to a secret manager before production.
JWT_SECRET=dev-only-change-me
JWT_TTL_SECONDS=3600

# --- Runtime limits ---------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_TOKEN_BUDGET=24000
AGENT_WALL_CLOCK_SECONDS=90
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
LOG_FORMAT=console
